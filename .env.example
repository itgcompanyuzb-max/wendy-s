PORT=3000
# Telegram Gateway API token (https://core.telegram.org/gateway) - login codes are sent through it
TELEGRAM_GATEWAY_TOKEN=
# Optional: WhatsApp Cloud API (developers.facebook.com > WhatsApp). Needs an approved AUTHENTICATION template
# whose text has {{1}} for the code (copy-code button). Both channels set = the customer chooses.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=login_code
WHATSAPP_TEMPLATE_LANG=ru
# The only phone number allowed into /admin/ at first (format +998XXXXXXXXX)
ADMIN_PHONE=+998XXXXXXXXX
# Optional: Yandex Maps Tiles API key. Empty = OpenStreetMap tiles
YANDEX_MAPS_KEY=
